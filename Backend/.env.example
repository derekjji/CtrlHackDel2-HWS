# Environment Configuration Template
# Copy this file to .env and fill in your actual values
# NEVER commit the .env file - it's in .gitignore

# DigitalOcean Spaces Configuration
DO_SPACE_NAME=your-space-name-here
DO_REGION=nyc3
DO_ACCESS_KEY=your-access-key-here
DO_SECRET_KEY=your-secret-key-here

# Encryption Key (generate with: openssl rand -hex 32)
ENCRYPTION_KEY=your-64-character-hex-key-here

# Notes:
# - Replace all "your-*-here" values with your actual credentials
# - Keep this file secure and never share it
# - The actual .env file is gitignored for safety
