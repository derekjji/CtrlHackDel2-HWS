# Port Configuration
PORT=4000

# CORS allowed origins (comma-separated)
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Path to C backend binary
# Windows: ..\\healthcare_backend.exe
# Linux: ../healthcare_backend
BACKEND_BINARY=..\\healthcare_backend.exe

# DigitalOcean Spaces Configuration
# (Must match Backend/.env values)
DO_SPACE_NAME=your-space-name-here
DO_REGION=nyc3
DO_ACCESS_KEY=your-access-key-here
DO_SECRET_KEY=your-secret-key-here

# Encryption Key (64 hex characters)
# (Must match Backend/.env value)
ENCRYPTION_KEY=your-64-character-hex-key-here

# Notes:
# - This API calls the C backend, so it needs the same credentials
# - The BACKEND_BINARY path is relative to web_api/ directory
# - On Windows use backslashes (\\), on Linux use forward slashes (/)
# - Keep this file secure and never commit it to Git
